[global]

ioengine=./unvme2_fio_plugin
json_path=./unvme2_config.json

size=${SIZE}
bs=64

thread=1
direct=1

filename=0000.00.05.0
exitall_on_error=1

variable_key_size=1
key_ratio=128.0:64.0:32.0:16.0:8.40:4.60

variable_value_size=1
value_ratio=${RATIO}

[load]
stonewall
rw=write
iodepth=128
numjobs=1


[warmup]
stonewall
rw=randwrite
iodepth=128
randseed=100
random_distribution=${DISTRIBUTION}