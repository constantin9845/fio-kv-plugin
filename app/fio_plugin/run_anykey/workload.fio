[global]

ioengine=./unvme2_fio_plugin
json_path=./unvme2_config.json


# size
# since fio block size is fixed at 64 --> size needs to be converted
# For approximate size : target size / average value size (from value_ratio) 

size=${SIZE}
bs=64

thread=1
direct=1

filename=0000.00.05.0
exitall_on_error=1

# Usage
# key_ratio=8.16.32.64.128.256_10.20.20.20.20.10 --> key ratio={size.size..}_{ratio.ratio..} (max 6)

variable_key_size=1
key_ratio=8.16.32.64.128.256_10.20.20.20.20.10

# Usage
# value_ratio=8.16.32.64.128_10.20.20.20.20 --> value ratio={size.size..}_{ratio.ratio..} (max 5)

variable_value_size=1
value_ratio=8.16.32.64.128_20.20.20.20.20

[run]
stonewall
rw=randrw
rwmixread=60
iodepth=32
numjobs=1
randseed=100
random_distribution=${DISTRIBUTION}