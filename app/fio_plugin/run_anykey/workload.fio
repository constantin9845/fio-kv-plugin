[global]

ioengine=./unvme2_fio_plugin
json_path=./unvme2_config.json

size=${SIZE}
bs=64

thread=1
direct=1

filename=0000.00.05.0
exitall_on_error=1

variable_key_size=1
key_ratio=128.0:64.0:32.40:16.60:8.0:4.0

variable_value_size=1
value_ratio=${RATIO}

[run]
stonewall
rw=randrw
rwmixread=90
iodepth=32
numjobs=1
randseed=100
random_distribution=${DISTRIBUTION}