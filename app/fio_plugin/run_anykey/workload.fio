[global]

ioengine=./unvme2_fio_plugin
json_path=./unvme2_config.json


size=${SIZE}
bs=64

direct=1
thread=1
group_reporting=1
filename=0000.00.05.0
exitall_on_error=1


variable_key_size=1
key_ratio=32.64_20.80

variable_value_size=1
value_ratio=100.200.2048_20.75.5

[run]
stonewall
rw=randrw
rwmixread=95
iodepth=32
randseed=100
random_distribution=${DISTRIBUTION}